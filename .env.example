POSTGRES_DB=lenny_growth
POSTGRES_USER=lenny_app
POSTGRES_PASSWORD=your_secure_password_here

DATABASE_URL=postgresql+psycopg://lenny_app:your_secure_password_here@localhost:5434/lenny_growth

OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIMENSIONS=768

CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
EMBED_BATCH_SIZE=16

# Chat & Inference Configuration
# Options for CHAT_PROVIDER: "ollama" (default local), "litellm" (optional cloud)
CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
CHAT_TIMEOUT_SECONDS=120.0
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_COSINE_DISTANCE=0.30
CHAT_MAX_HISTORY_MESSAGES=10

# Cloud Inference via LiteLLM (Optional)
LITELLM_MODEL=
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_TIMEOUT_SECONDS=120.0

# Cloud Inference via NVIDIA NIM (openai/gpt-oss-20b)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=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
NVIDIA_TIMEOUT_SECONDS=120.0

# Agent Orchestrator Configuration
# Options for CHAT_ORCHESTRATOR: "rag" (default, direct prompt+retrieval), "pi" (Pi Coding Agent SDK)
CHAT_ORCHESTRATOR=rag
AGENT_INTERNAL_TOKEN=your-agent-internal-secret-token-here

# Pi Coding Agent Service Configuration (Node.js agent-service)
PI_AGENT_HOST=127.0.0.1
PI_AGENT_PORT=3000
PI_AGENT_REQUEST_TIMEOUT_SECONDS=120.0
PI_AGENT_MODEL_PROVIDER=ollama
PI_AGENT_MODEL_ID=qwen2.5:1.5b
PI_AGENT_MODEL_BASE_URL=http://localhost:11434/v1
PI_AGENT_MODEL_API_KEY=

# Ship 30 for 30 Essay Generation & Writing Configuration
WRITING_TARGET_WORD_COUNT=1250
WRITING_TIMEOUT_SECONDS=300.0

# Durable Queue & Background Worker Configuration
REDIS_URL=redis://127.0.0.1:6379/0
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT_SECONDS=360.0
WORKER_STALE_JOB_TIMEOUT_SECONDS=300.0
MAX_JOB_RETRIES=2

# Retrieval Configuration ("semantic" or "hybrid" with Reciprocal Rank Fusion)
RETRIEVAL_MODE=hybrid
